# ==================== stock-review 部署配置模板 ====================
# 复制为 .env 后填写实际值：cp .env.example .env
# 注意：.env 含密钥，已被 .gitignore 排除，请勿提交

# ---------- PostgreSQL（db 服务） ----------
POSTGRES_DB=stock_review
POSTGRES_USER=stock_user
# db 容器初始化密码（docker-compose.yml 中 db 服务硬编码了 stock2024，保持与此一致）
POSTGRES_PASSWORD=stock2024
# backend 连接 db 的密码（必须与 POSTGRES_PASSWORD 相同；compose 有默认值 stock2024）
DB_PASSWORD=stock2024

# ---------- 邮件（注册/通知发送） ----------
MAIL_PASSWORD=your_smtp_password

# ---------- 微信公众号 ----------
WEIXIN_APP_ID=your_app_id
WEIXIN_APP_SECRET=your_app_secret

# ---------- DeepSeek / OpenAI 兼容 AI 分析 ----------
# 代码把 DEEPSEEK_API_URL 当【完整端点】用，必须写到 /chat/completions
# （llm_client 兼容根路径与完整端点两种写法，但 ai_service / limit_up_analyzer 只认完整端点）
# 当前生产用 wasu 网关（注意是 token.wasu.cn；api.wasu.cn 不是 OpenAI 兼容入口，会 404）：
#   DEEPSEEK_API_URL=https://token.wasu.cn/v1/chat/completions
#   DEEPSEEK_MODEL=deepseek-v4.1-flash
# 该网关可用模型用 GET <base>/models 查询；注意并无 deepseek-v1-flash，deepseek 系只有
# v4-pro / v4.1-flash / v4-flash / v4-pro-0813。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MODELS=deepseek-chat

# ---------- 思考开关（重要！推理模型的坑） ----------
# deepseek-v4.x 都是推理模型：先输出 reasoning_content，再输出正文 content。
# 对「按要求抽取/归并成 JSON」这类任务，推理会吃掉大量甚至全部预算，表现为
# finish_reason=length 且 content 为空，业务端报「AI 返回格式解析失败」。
# 实测（2026-09-28, deepseek-v4.1-flash，关键词归并三天数据 prompt）：
#   4096 预算  → content=0，4096 token 全给推理，耗时 40s
#   16000 预算 → 仍 content=0，推理耗尽 16000，耗时 149s
# 该网关支持 enable_thinking=false 关思考，同一 prompt：31.1s/推理3005token → 2~4s/推理0token，JSON 正常
# 因此默认关闭思考；确实需要推理质量时改为 false，并务必大幅调高下面的 MAX_TOKENS
# （否则正文会被推理挤成空串，老毛病复现）
DEEPSEEK_DISABLE_THINKING=true
# 单次请求读超时（秒）。原代码写死 60s，推理模型下个股分析实测 40s+ 会顶到超时直接报错
DEEPSEEK_TIMEOUT=180

# ---------- 各用途 max_tokens 上限 ----------
# 关思考后这些只是上限、余量充足；仅当 DEEPSEEK_DISABLE_THINKING=false 时才需按推理量上调
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS_SHORT=2000
DEEPSEEK_MAX_TOKENS_MEDIUM=6000
DEEPSEEK_MAX_TOKENS_LONG=10000

# ---------- 硅基流动（保留，当前代码未使用） ----------
SILICONFLOW_API_KEY=

# ---------- TDX 行情库（量化筛选/概念板块，由 tdx_daily 同步） ----------
# 指向部署机 postgres 容器的 quantdb 库；未配置时筛选接口返回 503 提示
TDX_DATABASE_URL=postgresql://stock_user:stock2024@db:5432/quantdb

# ---------- 通达信实时行情服务器（重要） ----------
# mootdx 未固定节点时会用它内置列表里"最快/第一台"的节点，而**很多节点能连上却返回空数据**
# （本机实测选中 180.153.18.170:7709 → quotes/bars 全空），于是实时行情静默走新浪兜底、
# 日K走腾讯兜底，表象很像"通达信协议被拒绝"。
# 实测：tdxpy 内置 104 家行情服务器中仅 8 家真正可用，全部是国泰君安 117.34.114.13~20/27:7709。
# 启动时 app/core/tdx_server.py 会按下面的顺序探测并固定第一台可用节点（写入 mootdx BESTIP）。
TDX_SERVER=117.34.114.13:7709,117.34.114.14:7709,117.34.114.15:7709
