# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_review
DB_USER=postgres
DB_PASSWORD=postgres

# Flask配置
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# 邮件配置
MAIL_PASSWORD=MAIL_PASSWORD_REMOVED

# DeepSeek API配置
DEEPSEEK_API_KEY=DEEPSEEK_API_KEY_REMOVED
# API地址（可选，默认为官方地址）
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
# 默认模型（可选，默认为deepseek-v4-flash）
DEEPSEEK_MODEL=deepseek-v4-flash
# 模型降级策略（可选，默认为deepseek-v4-flash,deepseek-v4-pro）
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
# AI参数配置（可选）
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS_SHORT=500
DEEPSEEK_MAX_TOKENS_MEDIUM=1000
DEEPSEEK_MAX_TOKENS_LONG=4000
